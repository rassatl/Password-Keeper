# URL de l'API FastAPI (utilisée par le build de prod du frontend, hors Docker)
VITE_API_URL=http://localhost:8000

# Connexion PostgreSQL utilisée par FastAPI en dehors de Docker
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/password_keeper

# --- Utilisé uniquement par docker-compose pour initialiser le conteneur Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=password_keeper
